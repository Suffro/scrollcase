{
  "name": "scrollcase",
  "version": "0.1.0",
  "description": "Build signed, verifiable, installable Python environment boxes for scientific models.",
  "license": "Apache-2.0",
  "author": "Lorenzo S. (https://github.com/suffro)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suffro/scrollcase.git"
  },
  "homepage": "https://scrollcase.dev",
  "bugs": {
    "url": "https://github.com/suffro/scrollcase/issues"
  },
  "keywords": [
    "packaging",
    "conda",
    "conda-forge",
    "pixi",
    "conda-pack",
    "python",
    "reproducible-builds",
    "lockfile",
    "signing",
    "ed25519",
    "relocatable",
    "air-gapped",
    "scientific-computing",
    "ml"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./contract": "./src/contract/index.mjs",
    "./contract/types": {
      "types": "./src/contract/types/index.d.ts"
    },
    "./build": "./src/build/index.mjs",
    "./contract/schema/*.json": "./src/contract/schema/*.json",
    "./contract/fixtures/*.json": "./src/contract/fixtures/*.json",
    "./sign": "./src/sign/index.mjs"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --config tests/unit/vitest.config.mjs",
    "types": "node scripts/generate-contract-types.mjs",
    "types:check": "node scripts/generate-contract-types.mjs --check",
    "prepublishOnly": "npm test && npm run types:check"
  },
  "dependencies": {
    "tar": "7.5.22",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "vitest": "^4.1.9"
  },
  "bin": {
    "scrollcase": "src/cli.mjs"
  }
}
