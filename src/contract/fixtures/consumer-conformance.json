            "variables": [
              {
                "name": "SCROLLCASE_ENV_PRECEDENCE",
                "source": "release",
                "value": "release-value",
                "executionAffecting": false,
                "conflict": true,
                "sources": [
                  {
                    "source": "host",
                    "name": "SCROLLCASE_ENV_PRECEDENCE",
                    "value": "<masked>"
                  },
                  {
                    "source": "caller",
                    "name": "SCROLLCASE_ENV_PRECEDENCE",
                    "value": "caller-value"
                  },
                  {
                    "source": "release",
                    "name": "SCROLLCASE_ENV_PRECEDENCE",
                    "value": "release-value"
                  }
                ]
              }
            ]
          }
        },
        "effectiveEnvironment": {
          "SCROLLCASE_ENV_PRECEDENCE": "release-value"
        }
